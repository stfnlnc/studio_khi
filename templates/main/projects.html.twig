{% extends 'base.html.twig' %}

{% block title %}
    Nos Réalisations - {{ parent() }}
{% endblock %}

{% block meta %}
    <meta name="description"
          content="Découvrez une série de projets sur lesquels nous avons travaillé, allant de la création d'identités visuelles à la conception de sites web.">
    <meta property="og:title" content="Réalisations - Studio Khi"/>
    <meta property="og:description"
          content="Découvrez une série de projets sur lesquels nous avons travaillé, allant de la création d'identités visuelles à la conception de sites web."/>
    <meta property="og:url" content="https://studiokhi.com{{ path('app_projects') }}"/>
    {{ parent() }}
{% endblock %}

{% block body %}
    <section class="container__large primary-light--bg pt--10 pb--10 flex row align--center">
        <div class="container">
            <div class="flex col gap--16 pt--10">
                <div class="flex col gap--3">
                    <h1 class="reveal">Nos Réalisations</h1>
                </div>
                <div class="flex row justify--end">
                    <div class="w--60 w-100-mobile flex col align--start justify--start gap--11">
                        <p class="w--80 w-100-mobile text__m">
                            Découvrez une série de projets sur lesquels nous avons travaillé, allant de la création d'identités
                            visuelles à la conception de sites web. Chaque projet est une histoire à part entière, reflétant notre
                            passion pour le design et notre volonté de satisfaire nos clients.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="container__large primary-light--bg border--top border--bottom border-stroke-light">
        <div class="container container__scroll pt--11 pb--11 flex row align--center justify--center justify--start-mobile gap--5">
                <span id="all" class="filter filter--active">
                    Tous les projets
                </span>
            {% for tag in tags %}
                <span id="{{ tag.slug }}" class="filter">
                    {{ tag.name }}
                </span>
            {% endfor %}
        </div>
    </section>
    <section class="container__large primary-light--bg">
        <div class="container flex col gap--16 gap-large-mobile align--start justify--center">
            <div class="grid grid--2 grid-gap--5 row grid--1-mobile">
                {% for key, project in projects %}
                    <article
                            class="flex col gap--5 article mb--20 {% for tag in project.tag.toArray %} {{ tag.slug }} {% endfor %}">
                        <a href="{{ path('app_show', {'slug': project.slug}) }}" class="relative"
                           aria-label="{{ project.name }}">
                            {% if project.image is not empty %}
                                <img class="home__img home__img-post"
                                     src="{{ asset('uploads/projects/featured/large/') ~ project.image }}"
                                     loading="lazy" alt="{{ project.name }}">
                            {% else %}
                                <img class="home__img home__img-post"
                                     src="{{ asset('build/images/background/empty.png') }}"
                                     loading="lazy" alt="{{ project.name }}">
                            {% endif %}
                            <div class="absolute pos-t--4 pos-l--4 flex row col-mobile gap--2">
                                {% for tag in project.tag.toArray %}
                                    <span class="tag tag__{{ tag.color }}">{{ tag.name }}</span>
                                {% endfor %}
                            </div>
                            <svg class="absolute pos-center" viewBox="0 0 125 125" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle id="Ellipse 1" cx="62.5" cy="62.5" r="62.5" fill="white"/>
                                <path id="Vector" d="M49.5 75.5L74.5 50.5" stroke="#191919" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                                <path id="Vector_2" d="M54.1875 50.5H74.5V70.8125" stroke="#191919" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                        <a href="{{ path('app_show', {'slug': project.slug}) }}" class="flex col gap--3">
                            <div class="flex row align--end justify--space-between">
                                <p class="text__s">
                                    {{ project.name }}
                                </p>
                                <p class="text__s hide-mobile">
                                    {{ project.category }}
                                </p>
                            </div>
                            <div class="flex col align--start justify--start gap--4">
                                <p class="primary-grey text__s">
                                    {{ project.title }}
                                </p>
                                <p class="text__s display-mobile">
                                    {{ project.category }}
                                </p>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
