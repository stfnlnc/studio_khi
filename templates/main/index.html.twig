{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} - Création de sites web et identités visuelles
{% endblock %}

{% block meta %}
    <meta name="description"
          content="Studio Khi est un studio indépendant qui conçoit des sites et des designs sur mesure pour des marques et des entrepreneurs qui souhaitent se démarquer sur le web.">
    <meta property="og:title" content="Studio Khi"/>
    <meta property="og:description"
          content="Studio Khi est un studio indépendant qui conçoit des sites et des designs sur mesure pour des marques et des entrepreneurs qui souhaitent se démarquer sur le web."/>
    <meta property="og:url" content="https://studiokhi.com"/>
    {{ parent() }}
{% endblock %}

{% block body %}
    <section id="top-content" class="container__large  flex row pb--10">
        <div class="w--100 flex col align--center justify--space-between h--100 h-100-mobile">
            <div></div>
            <div class="container mt--10 pb--0 flex col w--100 align--center gap--8">
                {% include 'main/components/button.html.twig' with
                    {
                        href: "https://calendly.com/studiokhi/appel-decouverte",
                        content: "Réservez votre appel découverte",
                        color: "",
                        target: "_blank",
                        icon: true}
                %}
                <p class="title-delay w--50 text-center w-100-mobile text__m">
                    Nous créons des sites et des designs pour des
                    marques et des entrepreneurs qui souhaitent se démarquer sur le web.
                </p>
            </div>
            <svg class="home__logo reveal" viewBox="0 0 805 100" xmlns="http://www.w3.org/2000/svg">
