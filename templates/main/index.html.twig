            </svg>
        </div>
    </section>
    <section class="container__large primary-light--bg border--top border-stroke-light">
        <div class="container flex row col-mobile gap-small-mobile">
            <p class="text__l w--40 w-100-mobile">
                Notre approche
            </p>
            <div class="w--50 w-100-mobile flex col align--start justify--start gap--11">
                <h3 class="">
                    On vous accompagne pour que vous ne ressembliez à personne.
                </h3>
                <p class="w-100-mobile primary-grey text__m">
                    Chez Studio Khi, nous combinons stratégie digitale, design et développement web pour créer des identités de marque et des sites que l'on remarque.
                    <br><br>
                    Nous vous aidons à :<br>
                    Définir votre positionnement <br>
                    Créer une identité forte <br>
                    Déployer un site orienté design
                </p>
                <div class="flex col align--start justify--start gap--2">
                    {% include 'main/components/link.html.twig' with
                        {
                            href: path('app_studio'),
                            content: "Découvrir le studio",
                            color: "dark",
                            target: "",
                            icon: true,
                            line: true
                        } %}
                    {% include 'main/components/link.html.twig' with
                        {
                            href: path('app_projects'),
                            content: "Voir nos réalisations",
                            color: "dark",
                            target: "",
                            icon: true,
                            line: true
                        } %}
                </div>
            </div>
        </div>
    </section>
    <section id="service-1" class="container__large secondary-green--bg h--100 h-100-mobile">
        <div class="container flex col justify--center">
            <div class="flex col gap--20">
                <div class="flex col gap--3">
                    <h1 class="">Branding & <br> Direction Artistique</h1>
                </div>
                <div class="flex row justify--end">
                    <div class="w--60 w-100-mobile flex col align--start justify--start gap--10">
                        <p class="w--80 w-100-mobile primary-grey text__m">
                            Du logo à un système graphique audacieux, nous élaborons ensemble une image qui vous ressemble pour renforcer votre présence en ligne.
                        </p>
                        {% include 'main/components/link.html.twig' with
                            {
                                href: path('app_service_branding'),
                                content: "Infos & Tarifs",
                                color: "dark",
                                target: "",
                                icon: true,
                                line: true
                            } %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="service-2" class="container__large secondary-blue--bg h--100 h-100-mobile">
        <div class="container flex col justify--center">
            <div class="flex col gap--20">
                <div class="flex col gap--3">
                    <h1 class="">Webdesign & <br> Design Digital</h1>
                </div>
                <div class="flex row justify--end">
                    <div class="w--60 w-100-mobile flex col align--start justify--start gap--10">
                        <p class="w--80 w-100-mobile primary-grey text__m">
                            Nous sommes spécialisés dans la conception de sites web qui attirent et retiennent
                            l'attention. Notre approche est de trouver le juste équilibre entre beauté et fonctionnalité.
                        </p>
                        {% include 'main/components/link.html.twig' with
                            {
                                href: path('app_service_webdesign'),
                                content: "Infos & Tarifs",
                                color: "dark",
                                target: "",
                                icon: true,
                                line: true
                            } %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="service-3" class="container__large secondary-violet--bg h--100 h-100-mobile">
        <div class="container flex col justify--center">
            <div class="flex col gap--20">
                <div class="flex col gap--3">
                    <h1 class="">Développement Web & <br> Sites Sur Mesure</h1>
                </div>
                <div class="flex row justify--end">
                    <div class="w--60 w-100-mobile flex col align--start justify--start gap--10">
                        <p class="w--80 w-100-mobile primary-grey text__m">
                            Nous développons des sites web sur mesure qui rehaussent la présence en ligne de votre
                            marque. Grâce à notre expertise technique, nous transformons vos idées en réalité
                            digitale.
                        </p>
                        {% include 'main/components/link.html.twig' with
                            {
                                href: path('app_service_development'),
                                content: "Infos & Tarifs",
                                color: "dark",
                                target: "",
                                icon: true,
                                line: true
                            } %}
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="projects" class="primary-light--bg container__large">
        <div class="container flex col gap--16 gap-large-mobile align--start justify--center">
            <div class="flex row col-mobile w--100">
                <p class="text__l w--40 w-100-mobile">
                    Nos réalisations
                </p>
                <div class="w--60 w-100-mobile flex col align--start justify--start gap--11 hide-mobile">
                    <p class="w--80 w-100-mobile primary-grey text__m">
                        Nous nous efforçons de toujours créer quelque chose qui sort de l'ordinaire.
                        <br> <br>
                        Notre portfolio reflète notre expertise et notre engagement à fournir des produits et des
                        marques
                        numériques de haute qualité.
                    </p>
                </div>
            </div>
            {% for project in projects %}
                <article class="flex col gap--5 article w--100">
                    <a href="{{ path('app_show', {'slug': project.slug}) }}" class="relative"
                       aria-label="{{ project.name }}">
                        {% if project.image is not empty %}
                            <div class="overflow-hidden home__img">
                                <img class="home__img home__img-case"
                                     src="{{ asset('uploads/projects/featured/full/') ~ project.image }}"
                                     loading="lazy"
                                     alt="{{ project.name }}">
                            </div>
                        {% else %}
                            <img class="home__img home__img-case"
                                 src="{{ asset('build/images/background/empty.png') }}"
                                 loading="lazy" alt="{{ project.name }}">
                        {% endif %}

                        <div class="absolute pos-t--4 pos-l--4 flex row col-mobile gap--2">
                            {% for tag in project.tag.toArray %}
                                <span class="tag tag__{{ tag.color }}">{{ tag.name }}</span>
                            {% endfor %}
                        </div>
                        <svg class="absolute pos-center" width="125" height="125" viewBox="0 0 125 125" fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <circle id="Ellipse 1" cx="62.5" cy="62.5" r="62.5" fill="white"/>
                            <path id="Vector" d="M49.5 75.5L74.5 50.5" stroke="#191919" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                            <path id="Vector_2" d="M54.1875 50.5H74.5V70.8125" stroke="#191919" stroke-width="1.5"
                                  stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a href="{{ path('app_show', {'slug': project.slug}) }}" class="flex row col-mobile">
                        <p class="text__s w--40 w-100-mobile">
                            {{ project.name }}
                        </p>
                        <div class="w--60 w-100-mobile flex row col-mobile align--start justify--space-between gap--4">
                            <p class="w--80 w-100-mobile primary-grey text__s">
                                {{ project.title }}
                            </p>
                            <p class="text__s">{{ project.category }}</p>
                        </div>
                    </a>
                </article>
            {% endfor %}
            <div class="align--self-end">
                {% include 'main/components/link.html.twig' with
                    {
                        href: path('app_projects'),
                        content: "Voir toutes les réalisations",
                        color: "dark",
                        target: "",
                        icon: true,
                        line: true
                    } %}
            </div>
        </div>
    </section>
    {% include 'main/template-part/_process.html.twig' %}
    <section class="container flex col gap--16">
        <div class="flex row col-mobile gap-small-mobile">
            <p class="text__l w--40 w-100-mobile">
                Le studio
            </p>
            <div class="w--60 w-100-mobile flex col align--start justify--start gap--11">
                <h3 class="">
                    Un duo créatif au service d’une seule mission : vous rendre unique.
                </h3>
                <p class="w--80 w-100-mobile primary-grey text__m">
                    Derrière Studio Khi, nous sommes deux : une designer et un développeur. Nous avons rassemblé nos
                    compétences afin de vous proposer une expertise complète au service de votre marque.
                </p>
                <div class="flex col align--start justify--start gap--2">
                    {% include 'main/components/link.html.twig' with
                        {
                            href: path('app_studio'),
                            content: "Découvrir le studio",
                            color: "dark",
                            target: "",
                            icon: true,
                            line: true
                        } %}
                </div>
            </div>
        </div>
        <div class="flex row col-mobile gap--4">
            <div class="w--40 w-100-mobile">
                <img src="{{ asset('build/images/uploads/studio-1.webp') }}"
                     class="home__img home__img-studio-left" loading="lazy" alt="Le Studio">
            </div>
            <div class="w--60 w-100-mobile">
                <img src="{{ asset('build/images/uploads/studio-2.webp') }}"
                     class="home__img home__img-studio-right" loading="lazy" alt="Le Studio">
            </div>
        </div>
    </section>
    {% include('main/template-part/_review.html.twig') %}
    <section class="container__large primary-light primary-dark--bg">
        <div class="container flex col gap--16 gap-large-mobile align--center justify--center">
            <div class="flex row col-mobile w--100">
                <p class="text__l w--40 w-100-mobile">
                    Articles
                </p>
                <div class="w--60 flex col align--start justify--start gap--11 hide-mobile">
                    <p class="w--80 text__m">
                        Vous proposer notre vision et nos réflexions sur le design, le web et la stratégie digitale par
                        notre sélection d’articles.
                    </p>
                </div>
            </div>
            <div class="grid grid--2 grid-gap--5 row grid--1-mobile">
                {% for post in posts %}
                    <article class="flex col gap--5 article">
                        <a class="relative" href="{{ path('app_post', {slug: post.slug}) }}"
                           aria-label="{{ post.name }}">
                            {% if post.image is not empty %}
                                <div class="overflow-hidden home__img home__img-post">
                                    <img class="home__img home__img-post"
                                         src="{{ asset('uploads/posts/featured/large/') ~ post.image }}"
                                         loading="lazy" alt="{{ post.name }}">
                                </div>
                            {% else %}
                                <img class="home__img home__img-post"
                                     src="{{ asset('build/images/background/empty.png') }}"
                                     loading="lazy" alt="{{ post.name }}">
                            {% endif %}
                            <div class="absolute pos-t--4 pos-l--4 flex row col-mobile gap--2">
                                {% for tag in post.tag.toArray %}
                                    <span class="tag tag__{{ tag.color }}">{{ tag.name }}</span>
                                {% endfor %}
                            </div>
                            <svg class="absolute pos-center" width="125" height="125" viewBox="0 0 125 125" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <circle id="Ellipse 1" cx="62.5" cy="62.5" r="62.5" fill="white"/>
                                <path id="Vector" d="M49.5 75.5L74.5 50.5" stroke="#191919" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                                <path id="Vector_2" d="M54.1875 50.5H74.5V70.8125" stroke="#191919" stroke-width="1.5"
                                      stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </a>
                        <div class="flex col gap--3">
                            <p class="text__l">
                                {{ post.name }}
                            </p>
                            {% include 'main/components/link.html.twig' with
                                {
                                    href: path('app_post', {slug: post.slug}),
                                    content: "Lire l'article",
                                    color: "light",
                                    target: "",
                                    icon: false,
                                    line: true
                                } %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>
    <section class="container flex row col-mobile gap-large-mobile">
        <p class="text__l w--40 w-100-mobile">
            FAQ
        </p>
        <div class="w--60 w-100-mobile flex col align--start justify--start">
            {% for key, faq in faqs %}
                {% include 'main/components/faq.html.twig' with
                    {
                        title: faq.question,
                        content: faq.answer
                    } %}
            {% endfor %}
        </div>
    </section>
{% endblock %}
