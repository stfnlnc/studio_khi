{% extends 'base.html.twig' %}

{% block title %}
    Contact - {{ parent() }}
{% endblock %}

{% block meta %}
    <meta name="description"
          content="Vous souhaitez recevoir un devis sur mesure ? Remplissez le formulaire de contact et parlez-nous de votre projet. Nous avons hâte d'écouter votre projet.">
    <meta property="og:title" content="Contact - Studio Khi"/>
    <meta property="og:description"
          content="Vous souhaitez recevoir un devis sur mesure ? Remplissez le formulaire de contact et parlez-nous de votre projet. Nous avons hâte d'écouter votre projet."/>
    <meta property="og:url" content="https://studiokhi.com{{ path('app_contact') }}"/>
    {{ parent() }}
{% endblock %}

{% block body %}
    <section class="container__large container__top flex col justify--center primary-light primary-dark--bg">
        <div class="container flex col gap--12">
            <h1 class="reveal w--70 w-100-mobile">Nous avons hâte d'écouter votre projet</h1>
            <div class="flex row col-mobile gap-small-mobile">
                <div class="w--40 w-100-mobile"></div>
                <div class="w--60 w-100-mobile flex col align--start justify--start gap--11">
                    <div class="w--80 w-100-mobile text__m flex col gap--1">
                        <a class="" href="tel:0765889683">07 65 88 96 83</a>
                        <a href="mailto:hello@studiokhi.com">hello@studiokhi.com</a>
                        <p class="mt--4 mb--4">
                            Remote depuis les Pyrénées
                        </p>
                        {% include 'main/components/button.html.twig' with
                            {
                                href: "https://calendly.com/studiokhi/appel-decouverte",
                                content: "Réservez votre appel découverte",
                                color: "light",
                                target: "_blank",
                                icon: true}
                        %}
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}


