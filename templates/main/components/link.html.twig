<div class="w-fit-content">
    <a id="{{ id|default(null) }}" target="{{ target|default(null) }}" href="{{ href|default(null) }}"
       class="{{ color|default(null) ? 'link link__' ~ color : 'link' }}">
    {{ content|default(null) }}
    {% if icon|default(null) %}
        <svg class="{{ icon|default(null) ? 'link__icon link__' ~ color|default(null) ~'__icon' : 'link__icon' }}" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
            <path d="M4.5 13.5L13.5 4.5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6.1875 4.5H13.5V11.8125" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    {% endif %}
    </a>
    {% if line|default(null) %}
        <div class="{{ color ? 'line line__' ~ color : 'line' }}"></div>
    {% endif %}
</div>